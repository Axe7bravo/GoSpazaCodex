{
  "name": "gospaza",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "pnpm": "10.11.1"
  },
  "scripts": {
    "env:setup": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others --names backend,customer,merchant,driver,admin \"pnpm --filter @gospaza/backend run dev\" \"pnpm --filter @gospaza/customer run dev\" \"pnpm --filter @gospaza/merchant run dev\" \"pnpm --filter @gospaza/driver run dev\" \"pnpm --filter @gospaza/admin run dev\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "db:migrate": "pnpm --filter @gospaza/backend run db:migrate",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@10.11.1"
}
