NODE_ENV=production
# Set APP_ENV=staging on staging; NODE_ENV remains production.
APP_ENV=production
DATABASE_URL=postgres://replace-me:replace-me@database.internal:5432/gospaza
REDIS_URL=rediss://redis.internal:6379/0
BACKEND_URL=https://api.example.com
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://shop.example.com,https://merchant.example.com,https://driver.example.com,https://admin.example.com
JWT_SECRET=replace-me-with-a-generated-secret
COOKIE_SECRET=replace-me-with-a-different-generated-secret

# Worker mode: shared (default), server, or worker.
MEDUSA_WORKER_MODE=shared
# Boolean: true or false (default). Set true on a dedicated worker instance.
DISABLE_MEDUSA_ADMIN=false

# Production storage: Cloudflare R2. s3 / _S3_ name the compatible protocol, not AWS hosting.
# Private R2 bucket: disable r2.dev public access; do not attach a public custom domain.
# Use a dedicated R2 Object Read & Write credential scoped to this bucket only.
APPLICATION_FILES_PROVIDER=s3
APPLICATION_FILES_S3_ENDPOINT=https://replace-me-account-id.r2.cloudflarestorage.com
APPLICATION_FILES_S3_BUCKET=replace-me-private-applications
APPLICATION_FILES_S3_REGION=auto
APPLICATION_FILES_S3_ACCESS_KEY_ID=replace-me-private-r2-access-key-id
APPLICATION_FILES_S3_SECRET_ACCESS_KEY=replace-me-private-r2-secret-access-key

# M5 separate PUBLIC Cloudflare R2 catalogue bucket; never reuse the private bucket.
# Attach a production custom domain to this bucket only; leave r2.dev disabled.
# Use a separate R2 Object Read & Write credential scoped to this bucket only.
# For jurisdictional buckets, use the matching R2 S3 endpoint shown by Cloudflare.
CATALOGUE_FILES_PROVIDER=s3
CATALOGUE_FILES_S3_ENDPOINT=https://replace-me-account-id.r2.cloudflarestorage.com
CATALOGUE_FILES_S3_BUCKET=replace-me-public-catalogue
CATALOGUE_FILES_S3_REGION=auto
CATALOGUE_FILES_S3_ACCESS_KEY_ID=replace-me-public-r2-access-key-id
CATALOGUE_FILES_S3_SECRET_ACCESS_KEY=replace-me-public-r2-secret-access-key
# Custom-domain origin, not the authenticated S3 endpoint or an r2.dev URL.
CATALOGUE_FILES_PUBLIC_URL=https://media.example.com
