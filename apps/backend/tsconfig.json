{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx"
  },
  "ts-node": { "swc": true },
  "include": ["medusa-config.ts", "src/**/*.ts", "tests/**/*.ts", ".medusa/types/*.ts"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin"]
}
