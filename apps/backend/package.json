{
  "name": "@gospaza/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "start": "cd .medusa/server && medusa start",
    "build": "medusa build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "medusa db:migrate",
    "auth:publishable-key": "medusa exec ./src/scripts/create-auth-publishable-key.ts",
    "test:integration": "medusa exec ./src/scripts/verify-auth.ts"
  },
  "dependencies": {
    "@gospaza/config": "workspace:*",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "ioredis": "^5.8.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@gospaza/test-utils": "workspace:*",
    "@swc/core": "^1.7.28",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "vite": "^5.4.14"
  }
}
