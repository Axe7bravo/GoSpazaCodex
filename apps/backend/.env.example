APP_ENV=development
DATABASE_URL=postgres://gospaza:replace-me@localhost:5432/gospaza
REDIS_URL=redis://localhost:6379/0
BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3003
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
JWT_SECRET=replace-me-with-a-generated-secret
COOKIE_SECRET=replace-me-with-a-different-generated-secret

# Worker mode: shared (default), server, or worker.
MEDUSA_WORKER_MODE=shared
# Boolean: true or false (default). Set true on a dedicated worker instance.
DISABLE_MEDUSA_ADMIN=false
# Merchant invitation lifetime in whole days (default 7, allowed 1-30).
MERCHANT_INVITATION_EXPIRY_DAYS=7

# M2 private bytes default to repository .private/merchant-documents.
APPLICATION_FILES_PROVIDER=local
# Optional absolute directory outside public/static/build paths.
# APPLICATION_FILES_LOCAL_DIR=D:/private/gospaza-applications

# M5 public catalogue images; separate from private application documents.
# Local uploads are served from backend /static/catalogue; no extra secrets needed.
CATALOGUE_FILES_PROVIDER=local

# Production uses Cloudflare R2 through the existing s3-compatible provider.
# See .env.production.example for R2 endpoints, region=auto and the public custom domain.

# M10-D is opt-in. Keep disabled outside isolated verification until M10-E is verified.
YOCO_ENABLED=false
# Separate payment-capacity commitment; never renews the original M9 hold.
PAYMENT_PENDING_MINUTES=15
# Deliberately NONFUNCTIONAL test credentials. The payment-initiation verifier
# intercepts Yoco transport. These are not credentials for a real checkout.
YOCO_SECRET_KEY=sk_test_verification
YOCO_WEBHOOK_SECRET=whsec_BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
YOCO_RETURN_ORIGINS=http://localhost:3000
YOCO_SUCCESS_URL=http://localhost:3000/checkout/return
YOCO_CANCEL_URL=http://localhost:3000/checkout/return
YOCO_FAILURE_URL=http://localhost:3000/checkout/return

# M10-E worker: leave enabled for real operation. Disable only for isolated local
# provider-transport verification, in BOTH backend and verifier environments.
PAYMENT_RECONCILIATION_WORKER_ENABLED=true
